{
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    // The page imports the Solid registry source where `shadcn add` puts it in an app; these paths
    // point those imports at the source in this repository, and the source's own imports where
    // registry/solid/tsconfig.json points them.
    "paths": {
      "@/components/calendar/event-colors": [
        "../../../../registry/shared/calendar-theme/event-colors"
      ],
      "@/components/calendar/list-view/*": ["../../../../registry/solid/list-view/*"],
      "@/components/calendar/*": ["../../../../registry/solid/calendar/*"],
      "@moltenship/calendar": ["../../../../packages/calendar-solid/src/index.ts"],
      "@registry/shared/*": ["../../../../registry/shared/*"],
      "@registry/*": ["../../../../registry/solid/*"]
    },
    "types": []
  },
  "include": ["*.tsx"]
}
