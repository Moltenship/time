{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "calendar",
  "type": "registry:component",
  "title": "Calendar shell",
  "description": "Toolbar, view switcher, event chip, accessible event names, English screen-reader announcements of gestures, undo and redo, sidebar mini month, the endless scroll axis, and the replaceable shading of closed time and resource status badges shared by every calendar view.",
  "dependencies": ["@moltenship/calendar", "cn", "lucide-react"],
  "registryDependencies": ["@moltenship/calendar-theme", "@moltenship/calendar-ui"],
  "files": [
    {
      "path": "registry/calendar/calendar-toolbar.tsx",
      "type": "registry:component",
      "target": "@components/calendar/calendar-toolbar.tsx"
    },
    {
      "path": "registry/shared/calendar/announcements.ts",
      "type": "registry:lib",
      "target": "@components/calendar/announcements.ts"
    },
    {
      "path": "registry/calendar/event-chip.tsx",
