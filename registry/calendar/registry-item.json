      "target": "@components/calendar/event-label.ts"
    },
    {
      "path": "registry/calendar/mini-month.tsx",
      "type": "registry:component",
      "target": "@components/calendar/mini-month.tsx"
    },
    {
      "path": "registry/calendar/preview-check.ts",
