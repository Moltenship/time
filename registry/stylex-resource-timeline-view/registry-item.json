{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "stylex-resource-timeline-view",
  "type": "registry:component",
  "title": "Resource timeline (StyleX)",
  "description": "Resources as rows and time as columns for a day of hours or a week or month of days: a sticky resource column with collapsible groups, a sticky header, events as bars packed into lanes, a now-line, drag and keyboard moves along time and across rows, and two-axis virtualization that renders only the rows and slots in view.",
  "dependencies": [
    "@astryxdesign/core",
    "@moltenship/calendar",
    "@stylexjs/stylex",
    "@tanstack/react-virtual",
    "lucide-react"
  ],
  "registryDependencies": ["@moltenship/stylex-calendar", "@moltenship/stylex-calendar-theme"],
  "files": [
    {
      "path": "registry/stylex-resource-timeline-view/resource-timeline-view.tsx",
      "type": "registry:component",
      "target": "@components/calendar-stylex/resource-timeline-view/resource-timeline-view.tsx"
    },
    {
      "path": "registry/stylex-resource-timeline-view/resource-timeline-grid.tsx",
      "type": "registry:component",
      "target": "@components/calendar-stylex/resource-timeline-view/resource-timeline-grid.tsx"
    },
    {
      "path": "registry/stylex-resource-timeline-view/resource-timeline-header.tsx",
      "type": "registry:component",
      "target": "@components/calendar-stylex/resource-timeline-view/resource-timeline-header.tsx"
    },
    {
      "path": "registry/stylex-resource-timeline-view/resource-timeline-row.tsx",
      "type": "registry:component",
      "target": "@components/calendar-stylex/resource-timeline-view/resource-timeline-row.tsx"
    },
    {
      "path": "registry/stylex-resource-timeline-view/resource-timeline-availability.tsx",
      "type": "registry:component",
      "target": "@components/calendar-stylex/resource-timeline-view/resource-timeline-availability.tsx"
    },
    {
      "path": "registry/stylex-resource-timeline-view/resource-timeline-event.tsx",
      "type": "registry:component",
      "target": "@components/calendar-stylex/resource-timeline-view/resource-timeline-event.tsx"
    },
    {
      "path": "registry/stylex-resource-timeline-view/resource-timeline-focus.tsx",
      "type": "registry:component",
      "target": "@components/calendar-stylex/resource-timeline-view/resource-timeline-focus.tsx"
    },
    {
      "path": "registry/stylex-resource-timeline-view/timeline-labels.ts",
      "type": "registry:lib",
      "target": "@components/calendar-stylex/resource-timeline-view/timeline-labels.ts"
    },
    {
      "path": "registry/stylex-resource-timeline-view/timeline-placement.ts",
      "type": "registry:lib",
      "target": "@components/calendar-stylex/resource-timeline-view/timeline-placement.ts"
    },
    {
      "path": "registry/stylex-resource-timeline-view/timeline-scale.ts",
      "type": "registry:lib",
      "target": "@components/calendar-stylex/resource-timeline-view/timeline-scale.ts"
    },
    {
      "path": "registry/stylex-resource-timeline-view/use-timeline-virtualizer.ts",
      "type": "registry:hook",
      "target": "@components/calendar-stylex/resource-timeline-view/use-timeline-virtualizer.ts"
    }
  ]
}
