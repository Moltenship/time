{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "recurrence-scope-dialog",
  "type": "registry:component",
  "title": "Recurrence scope dialog",
  "description": "Asks whether a change to a recurring event applies to this event, this and following events, or all events, while the change waits on screen. A promise-based hook for onEventChange resolves the scope, or null on cancel so the change rolls back. The same dialog as the React registry's, in Solid.",
  "dependencies": ["@moltenship/calendar-solid"],
  "registryDependencies": ["@moltenship/calendar-ui"],
  "files": [
    {
      "path": "registry/solid/recurrence-scope-dialog/recurrence-scope-dialog.tsx",
      "type": "registry:component",
      "target": "@components/calendar/recurrence-scope-dialog/recurrence-scope-dialog.tsx"
    },
    {
      "path": "registry/solid/recurrence-scope-dialog/use-recurrence-scope-prompt.tsx",
      "type": "registry:hook",
      "target": "@components/calendar/recurrence-scope-dialog/use-recurrence-scope-prompt.tsx"
    },
    {
      "path": "registry/shared/recurrence-scope-dialog/recurrence-scope.ts",
      "type": "registry:lib",
      "target": "@components/calendar/recurrence-scope-dialog/recurrence-scope.ts"
    },
    {
      "path": "registry/shared/recurrence-scope-dialog/recurrence-scope-dialog.styles.ts",
      "type": "registry:lib",
      "target": "@components/calendar/recurrence-scope-dialog/recurrence-scope-dialog.styles.ts"
    }
  ]
}
