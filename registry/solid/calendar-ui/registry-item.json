{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "calendar-ui",
  "type": "registry:component",
  "title": "Calendar controls",
  "description": "The calendar's own controls, thin wrappers over ui-sdk's Solid components in the calendar's look: button, badge, tooltip, select, popover, dialog and toast, and the icons the kit and the views draw. Each control's classes live in a plain .styles.ts file beside it, the same file the React kit installs. They land under components/calendar/ui, apart from the app's own components/ui.",
  "dependencies": ["@ui-sdk/core", "@ui-sdk/solid", "class-variance-authority", "cn"],
  "files": [
    {
      "path": "registry/solid/calendar-ui/button.tsx",
      "type": "registry:component",
      "target": "@components/calendar/ui/button.tsx"
    },
    {
      "path": "registry/shared/calendar-ui/button.styles.ts",
      "type": "registry:lib",
      "target": "@components/calendar/ui/button.styles.ts"
    },
    {
      "path": "registry/solid/calendar-ui/badge.tsx",
      "type": "registry:component",
      "target": "@components/calendar/ui/badge.tsx"
    },
    {
      "path": "registry/shared/calendar-ui/badge.styles.ts",
      "type": "registry:lib",
      "target": "@components/calendar/ui/badge.styles.ts"
    },
    {
      "path": "registry/solid/calendar-ui/tooltip.tsx",
      "type": "registry:component",
      "target": "@components/calendar/ui/tooltip.tsx"
    },
    {
      "path": "registry/shared/calendar-ui/tooltip.styles.ts",
      "type": "registry:lib",
      "target": "@components/calendar/ui/tooltip.styles.ts"
    },
    {
      "path": "registry/shared/calendar-ui/tooltip-handle.ts",
      "type": "registry:lib",
      "target": "@components/calendar/ui/tooltip-handle.ts"
    },
    {
      "path": "registry/solid/calendar-ui/select.tsx",
      "type": "registry:component",
      "target": "@components/calendar/ui/select.tsx"
    },
    {
      "path": "registry/shared/calendar-ui/select.styles.ts",
      "type": "registry:lib",
      "target": "@components/calendar/ui/select.styles.ts"
    },
    {
      "path": "registry/solid/calendar-ui/popover.tsx",
      "type": "registry:component",
      "target": "@components/calendar/ui/popover.tsx"
    },
    {
      "path": "registry/shared/calendar-ui/popover.styles.ts",
      "type": "registry:lib",
      "target": "@components/calendar/ui/popover.styles.ts"
    },
    {
      "path": "registry/shared/calendar-ui/popover-handle.ts",
      "type": "registry:lib",
      "target": "@components/calendar/ui/popover-handle.ts"
    },
    {
      "path": "registry/shared/calendar-ui/popup-side.ts",
      "type": "registry:lib",
      "target": "@components/calendar/ui/popup-side.ts"
    },
    {
      "path": "registry/solid/calendar-ui/dialog.tsx",
      "type": "registry:component",
      "target": "@components/calendar/ui/dialog.tsx"
    },
    {
      "path": "registry/shared/calendar-ui/dialog.styles.ts",
      "type": "registry:lib",
      "target": "@components/calendar/ui/dialog.styles.ts"
    },
    {
      "path": "registry/solid/calendar-ui/toast.tsx",
      "type": "registry:component",
      "target": "@components/calendar/ui/toast.tsx"
    },
    {
      "path": "registry/shared/calendar-ui/toast.styles.ts",
      "type": "registry:lib",
      "target": "@components/calendar/ui/toast.styles.ts"
    },
    {
      "path": "registry/shared/calendar-ui/toast-manager.ts",
      "type": "registry:lib",
      "target": "@components/calendar/ui/toast-manager.ts"
    },
    {
      "path": "registry/solid/calendar-ui/icons.tsx",
      "type": "registry:component",
      "target": "@components/calendar/ui/icons.tsx"
    }
  ]
}
