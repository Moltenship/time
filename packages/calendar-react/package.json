{
  "name": "@moltenship/calendar-react",
  "version": "1.0.0-rc.2",
  "description": "Headless React components and hooks for Moltenship Time, a calendar built on the Temporal API.",
  "keywords": [
    "calendar",
    "event-calendar",
    "headless",
    "react",
    "react-calendar",
    "react-component",
    "react-hooks",
    "scheduler",
    "ssr",
    "temporal",
    "typescript"
  ],
  "homepage": "https://time.molten.sh/docs/api/react",
  "bugs": {
    "url": "https://github.com/Moltenship/time/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Moltenship/time.git",
    "directory": "packages/calendar-react"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack && node scripts/verify-public-api.mjs",
    "dev": "vp pack --watch",
    "prepublishOnly": "echo \"Release with vp run release, which publishes the tarballs its gate checked. See docs/internal/releasing.md.\" && exit 1",
    "test": "vp test"
  },
  "dependencies": {
    "@moltenship/calendar-core": "workspace:*",
    "@moltenship/calendar-temporal": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
