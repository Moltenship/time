{
  "name": "@moltenship/calendar-recurrence",
  "version": "0.0.0",
  "description": "Range-bounded recurrence for Moltenship Time: RRULE expansion, exceptions and series edits.",
  "homepage": "https://moltenship-time.vercel.app/docs/api/recurrence",
  "bugs": {
    "url": "https://github.com/Moltenship/time/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Moltenship/time.git",
    "directory": "packages/calendar-recurrence"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "bench": "vp pack && vp test bench",
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "prepublishOnly": "echo \"Publish with vp run release:publish, after vp run release:dry-run. See docs/internal/releasing.md.\" && exit 1",
    "test": "vp test"
  },
  "dependencies": {
    "@moltenship/calendar-core": "workspace:*",
    "@moltenship/calendar-temporal": "workspace:*",
    "@moltenship/ics": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
