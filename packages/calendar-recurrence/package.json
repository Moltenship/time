{
  "name": "@moltenship/calendar-recurrence",
  "version": "0.0.0",
  "description": "Range-bounded recurrence for Moltenship Time: RRULE expansion, exceptions and series edits.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "bench": "vp pack && vp test bench",
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "prepublishOnly": "vp run build",
    "test": "vp test"
  },
  "dependencies": {
    "@moltenship/calendar-core": "workspace:*",
    "@moltenship/calendar-temporal": "workspace:*",
    "@moltenship/ics": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
