{
  "name": "@moltenship/calendar-recurrence",
  "version": "1.0.0-rc.2",
  "description": "Range-bounded recurrence for Moltenship Time: RRULE expansion, exceptions and series edits.",
  "keywords": [
    "calendar",
    "event-calendar",
    "exdate",
    "framework-agnostic",
    "icalendar",
    "recurrence",
    "recurring-events",
    "rfc5545",
    "rrule",
    "temporal",
    "typescript"
  ],
  "homepage": "https://time.molten.sh/docs/api/recurrence",
  "bugs": {
    "url": "https://github.com/Moltenship/time/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Moltenship/time.git",
    "directory": "packages/calendar-recurrence"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "prepublishOnly": "echo \"Release with vp run release, which publishes the tarballs its gate checked. See docs/internal/releasing.md.\" && exit 1",
    "test": "vp test"
  },
  "dependencies": {
    "@moltenship/calendar-core": "workspace:*",
    "@moltenship/ics": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
