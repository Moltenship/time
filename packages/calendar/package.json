{
  "name": "@moltenship/calendar",
  "version": "2.0.0",
  "description": "Moltenship Time for React, a headless calendar built on the Temporal API with week, day, month, year, agenda and resource views, exact time zones and DST, drag and drop, and actions an AI agent can call.",
  "keywords": [
    "agenda",
    "ai-agents",
    "calendar",
    "drag-and-drop",
    "dst",
    "event-calendar",
    "headless",
    "month-view",
    "nextjs",
    "react",
    "react-calendar",
    "react-component",
    "resource-timeline",
    "scheduler",
    "shadcn",
    "ssr",
    "temporal",
    "timezone",
    "typescript",
    "week-view"
  ],
  "homepage": "https://time.molten.sh/docs",
  "bugs": {
    "url": "https://github.com/Moltenship/time/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Moltenship/time.git",
    "directory": "packages/calendar"
  },
  "files": [
    "dist",
    "docs",
    "skills"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack && node --run docs",
    "dev": "vp pack --watch",
    "docs": "cd ../../apps/showcase && node --run docs:package",
    "prepublishOnly": "echo \"Release with vp run release, which publishes the tarballs its gate checked. See docs/internal/releasing.md.\" && exit 1",
    "test": "vp test --passWithNoTests"
  },
  "dependencies": {
    "@moltenship/calendar-core": "workspace:*",
    "@moltenship/calendar-dnd": "workspace:*",
    "@moltenship/calendar-react": "workspace:*",
    "@moltenship/calendar-temporal": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@ui-sdk/core": "catalog:",
    "@ui-sdk/react": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@ui-sdk/core": "^0.1.0-beta.16",
    "@ui-sdk/react": "^0.1.0-beta.16",
    "react": "^19.0.0"
  }
}
