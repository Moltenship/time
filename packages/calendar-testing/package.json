{
  "name": "@moltenship/calendar-testing",
  "version": "0.0.0",
  "private": true,
  "description": "Consumer-facing fixtures, harnesses, and semantic assertions for Moltenship Time.",
  "homepage": "https://moltenship-time.vercel.app/docs",
  "bugs": {
    "url": "https://github.com/Moltenship/time/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Moltenship/time.git",
    "directory": "packages/calendar-testing"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "prepublishOnly": "vp run build",
    "test": "vp test --passWithNoTests"
  },
  "dependencies": {
    "@moltenship/calendar": "workspace:*",
    "@moltenship/calendar-dnd": "workspace:*",
    "@moltenship/calendar-temporal": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
