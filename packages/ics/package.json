{
  "name": "@moltenship/ics",
  "version": "0.0.0",
  "description": "Typed, Temporal-native iCalendar (RFC 5545) parsing with Standard Schema support.",
  "license": "MIT",
  "files": [
    "dist",
    "THIRD-PARTY-NOTICES.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack && node scripts/check-size.mjs",
    "check": "vp check",
    "dev": "vp pack --watch",
    "generate:windows-zones": "node scripts/generate-windows-zones.mjs",
    "prepublishOnly": "vp run build",
    "size": "node scripts/check-size.mjs",
    "test": "vp test --passWithNoTests"
  },
  "devDependencies": {
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
