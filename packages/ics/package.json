{
  "name": "@moltenship/ics",
  "version": "0.0.0",
  "description": "Typed, Temporal-native iCalendar (RFC 5545) parsing with Standard Schema support.",
  "homepage": "https://moltenship-time.vercel.app/docs/api/ics",
  "bugs": {
    "url": "https://github.com/Moltenship/time/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Moltenship/time.git",
    "directory": "packages/ics"
  },
  "files": [
    "dist",
    "THIRD-PARTY-NOTICES.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "generate:windows-zones": "node scripts/generate-windows-zones.mjs",
    "prepublishOnly": "echo \"Publish with vp run release:publish, after vp run release:dry-run. See docs/internal/releasing.md.\" && exit 1",
    "test": "vp test --passWithNoTests"
  },
  "devDependencies": {
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
