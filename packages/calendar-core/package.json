{
  "name": "@moltenship/calendar-core",
  "version": "0.0.0",
  "description": "Framework-independent calendar data, projection, layout, and interaction engine.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack && node scripts/check-size.mjs",
    "check": "vp check",
    "dev": "vp pack --watch",
    "prepublishOnly": "vp run build",
    "size": "node scripts/check-size.mjs",
    "test": "vp test --passWithNoTests"
  },
  "dependencies": {
    "@flatten-js/interval-tree": "catalog:",
    "@moltenship/calendar-temporal": "workspace:*"
  },
  "devDependencies": {
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
