{
  "name": "@moltenship/calendar-dnd",
  "version": "2.0.0",
  "description": "Pointer drag, resize, and create interactions for Moltenship Time views.",
  "keywords": [
    "calendar",
    "drag-and-drop",
    "event-calendar",
    "pointer-events",
    "resize",
    "scheduler",
    "temporal",
    "typescript"
  ],
  "homepage": "https://time.molten.sh/docs/react/interactions",
  "bugs": {
    "url": "https://github.com/Moltenship/time/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Moltenship/time.git",
    "directory": "packages/calendar-dnd"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "prepublishOnly": "echo \"Release with vp run release, which publishes the tarballs its gate checked. See docs/internal/releasing.md.\" && exit 1",
    "test": "vp test --passWithNoTests"
  },
  "dependencies": {
    "@moltenship/calendar-core": "workspace:*",
    "@moltenship/calendar-temporal": "workspace:*"
  },
  "devDependencies": {
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
