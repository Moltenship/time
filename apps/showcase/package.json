{
  "name": "showcase",
  "version": "0.0.0",
  "private": true,
  "description": "Consumer-equivalent documentation, examples, and verification labs for Moltenship Time.",
  "type": "module",
  "scripts": {
    "build": "node --run registry && fumadocs-mdx && next build",
    "check": "vp check",
    "dev": "node --run registry && fumadocs-mdx && next dev",
    "links:check": "node --import ./scripts/register-fumadocs.mjs --import tsx ./scripts/check-links.ts",
    "postinstall": "fumadocs-mdx",
    "preview": "next start",
    "registry": "node --import tsx ../../tools/registry/src/build-cli.ts --out public/r",
    "search:check": "node scripts/verify-production.mjs",
    "source:generate": "fumadocs-mdx",
    "test": "vp test tests",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@moltenship/calendar": "workspace:*",
    "@moltenship/calendar-recurrence": "workspace:*",
    "@moltenship/ics": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-virtual": "catalog:",
    "fumadocs-core": "catalog:",
    "fumadocs-mdx": "catalog:",
    "fumadocs-ui": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shadcn": "catalog:",
    "temporal-polyfill": "catalog:",
    "tw-animate-css": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "catalog:",
    "@types/mdx": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "next-validate-link": "catalog:",
    "postcss": "catalog:",
    "registry": "workspace:*",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
